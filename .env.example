PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/findvehicle
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Google Sign-In (same Web client ID as frontend VITE_GOOGLE_CLIENT_ID). Leave empty to hide Google sign-in.
GOOGLE_CLIENT_ID=
# comma separated emails that become "admin" (Company console) when they register / sign in with Google
ADMIN_EMAILS=

# Email (leave SMTP_HOST empty -> emails such as the password-reset code are printed in the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vehicle Buddy <no-reply@vehiclebuddy.lk>"
# the company mailbox that receives the Contact page messages
COMPANY_EMAIL=
COMPANY_PHONE=+94754424053

# Vercel only: secret for GET /api/cron/run (deletes expired ads). Any long random text.
CRON_SECRET=

# used by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_password

# Cloudinary (free CDN for the ad photos + the home video): cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Buddy, the chat helper (Google Gemini). Leave empty to hide Buddy
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Top ads (paid featured ads) with PayHere ----
# "days:price in Rs." plans:
FEATURE_PLANS=3:500,7:1000,30:3000
# Leave the PayHere keys empty to run the Top ad payment in TEST mode (no money, only when NODE_ENV is not production)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
# the address PayHere can reach this API on (needed for the payment notification; localhost does not work), e.g. https://api.yoursite.lk
PUBLIC_API_URL=
